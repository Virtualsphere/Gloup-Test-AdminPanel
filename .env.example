# Admin panel API URLs are NOT branch-specific in source code.
# GitHub Actions writes .env on the server at deploy time:
#   push uat     → deploy-uat.yml  → ADMIN_UAT_* secrets
#   push master  → deploy.yml      → ADMIN_PROD_* secrets
#
# Vite bakes VITE_* into the JS bundle during `docker compose build`.
# Do not commit .env to git.

# ── Production (master → deploy.yml) ─────────────────────────────────────────
VITE_API_BASE_URL=https://api.v1.gloup.in
VITE_IMAGE_BASE_URL=https://api.v1.gloup.in
VITE_GOOGLE_MAPS_KEY=
PORT=3001

# ── UAT (uat branch → deploy-uat.yml) ────────────────────────────────────────
# VITE_API_BASE_URL=http://169.58.105.116:5678
# VITE_IMAGE_BASE_URL=http://169.58.105.116:5678
# VITE_GOOGLE_MAPS_KEY=
# PORT=3001

# ── Local dev (copy to .env.local, not used by CI) ───────────────────────────
# VITE_API_BASE_URL=http://YOUR_LAN_IP:5678
# VITE_IMAGE_BASE_URL=http://YOUR_LAN_IP:5678
